NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate at least 32 random bytes, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-cryptographically-random-secret
JWT_TTL_SECONDS=900
JWT_ISSUER=teca-api
JWT_AUDIENCE=teca-web

# Comma-separated exact origins. localhost is never added automatically in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Enables automatic appointment notifications according to each patient's preferred channel.
APPOINTMENT_COMMUNICATIONS_ENABLED=false

# Comma-separated options shown in patient forms: PHONE, EMAIL, WHATSAPP, SMS.
PREFERRED_COMMUNICATION_CHANNELS=PHONE,EMAIL

# Enables the Twilio provider specifically. Both flags must be true to send appointment SMS.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_GMAIL=
PASSWORD_APP=
BASE_URL=http://localhost:3000

# Keep clinical files outside the public web root and include this directory in backups.
DOCUMENT_STORAGE_PATH=/var/lib/teca/documents
# By default, legacy data and templates are read from ./Ejemplos clientes.
# Set these only when production keeps them in another private directory.
LEGACY_EXAMPLES_PATH=
PATIENT_TEMPLATE_PATH=
LEGACY_PATIENTS_FILE=
LEGACY_ATTACHMENTS_PATH=
LEGACY_REPORT_PATH=

# Only needed while running `npm run seed_user`; never commit the real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
